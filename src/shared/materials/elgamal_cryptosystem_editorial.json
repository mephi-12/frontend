[
    {
      "title": "Введение в криптосистему Эль-Гамаля",
      "anchor": "elgamal_intro",
      "text": "Криптосистема Эль-Гамаля — асимметричная система, основанная на сложности задачи дискретного логарифмирования. Используется для шифрования и электронной подписи.",
      "numeric_list": [
        "Публичный ключ: (p, g, y = g^x mod p)",
        "Приватный ключ: x",
        "Стойкость: эквивалентна решению DLP в конечной группе"
      ],
      "annotation": true
    },
    {
      "title": "Генерация ключей",
      "anchor": "key_generation",
      "childs": [
        {
          "subtitle": "Шаги генерации",
          "anchor": "keygen_steps",
          "numeric_list": [
            "Выбрать большое простое p и генератор g ∈ Z_p*",
            "Выбрать случайное x: 1 < x < p-1",
            "Вычислить y = g^x mod p"
          ],
          "childs": [
            {
              "text": "Пример: p = 23, g = 5, x = 7 → y = 5^7 mod 23 = 17"
            }
          ]
        }
      ]
    },
    {
      "title": "Шифрование сообщения",
      "anchor": "encryption",
      "childs": [
        {
          "subtitle": "Алгоритм шифрования",
          "anchor": "encrypt_algo",
          "numeric_list": [
            "Выбрать случайное k: 1 < k < p-1",
            "Вычислить c1 = g^k mod p",
            "Вычислить c2 = m·y^k mod p"
          ]
        }
      ]
    },
    {
      "title": "Расшифрование",
      "anchor": "decryption",
      "childs": [
        {
          "subtitle": "Процедура расшифровки",
          "anchor": "decrypt_procedure",
          "numeric_list": [
            "Вычислить s = c1^x mod p",
            "Найти обратный элемент s^{-1} mod p",
            "m = c2·s^{-1} mod p"
          ]
        }
      ]
    },
    {
      "title": "Электронная подпись",
      "anchor": "digital_signature",
      "childs": [
        {
          "subtitle": "Генерация подписи",
          "anchor": "sign_generation",
          "numeric_list": [
            "Вычислить хеш сообщения h(m)",
            "Выбрать случайное k (взаимно простое с p-1)",
            "r = g^k mod p",
            "s = k^{-1}(h(m) - xr) mod (p-1)"
          ]
        },
        {
          "subtitle": "Проверка подписи",
          "anchor": "sign_verification",
          "numeric_list": [
            "Вычислить левую часть: y^r·r^s mod p",
            "Вычислить правую часть: g^{h(m)} mod p",
            "Подпись верна ⇔ LHS ≡ RHS"
          ]
        }
      ]
    }
]
